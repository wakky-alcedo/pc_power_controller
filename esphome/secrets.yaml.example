# Copy this file to secrets.yaml (same directory) and fill in real values.
# secrets.yaml must NEVER be committed to git -- add it to .gitignore.

wifi_ssid: "YOUR_WIFI_SSID"
wifi_password: "YOUR_WIFI_PASSWORD"

# Password for the fallback AP the device broadcasts if it can't join Wi-Fi.
# Must be at least 8 characters (WPA2 minimum).
wifi_ap_password: "CHANGE_ME_FALLBACK_AP_PW"

# 32-byte key, base64-encoded, for the encrypted Home Assistant API.
# Generate one with:
#   python3 -c "import secrets, base64; print(base64.b64encode(secrets.token_bytes(32)).decode())"
# or let the ESPHome dashboard/CLI generate it for you on first compile.
api_encryption_key: "REPLACE_WITH_32_BYTE_BASE64_KEY"

# Password required to push OTA firmware updates.
ota_password: "CHANGE_ME_OTA_PASSWORD"
